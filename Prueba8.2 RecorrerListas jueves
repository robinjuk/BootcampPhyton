#Función python: Es mas pythonico y eficiente. en este caso, solo devuelve true en caso de encontrarlo y false en caso de que no. No devuelve elnúmero
#de repeticiones, posiciones, etc...
def buscar_con_ia (elementobuscar, notas):
    return elementobuscar in notas

